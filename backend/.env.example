# Copy to .env and fill in real values for a non-demo run.
# Every value below has a safe, offline default (see agiresearch/config.py) —
# the pipeline runs end-to-end with none of this set, using the deterministic
# fake LLM and fake arXiv discovery.

# --- LLM provider ---------------------------------------------------------
# fake (default, offline) | openai | anthropic
LLM_PROVIDER=fake
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- arXiv discovery -------------------------------------------------------
# fake (default, offline, synthesizes a small deterministic paper set)
# live (real arXiv API — no key needed, just network access)
ARXIV_PROVIDER=fake

# Max papers evaluated concurrently per research run (bounded — see ADR 0007).
EVALUATION_CONCURRENCY=4

# --- Storage ---------------------------------------------------------------
DATABASE_URL=sqlite:///./data/agiresearch.db

# --- API / auth --------------------------------------------------------------
API_BEARER_TOKEN=dev-local-token
CORS_ALLOW_ORIGINS=["http://localhost:3000"]
